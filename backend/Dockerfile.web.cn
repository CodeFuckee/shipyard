ARG BASE_IMAGE=docker.1ms.run/nginx:alpine
FROM ${BASE_IMAGE}

RUN apk add --no-cache wget unzip

ARG GITHUB_REPO=CodeFuckee/mobile_portainer_flutter_module
# 下载源，默认 github.com（国内用户可构建时覆盖为镜像站）
ARG DOWNLOAD_BASE=https://github.com

RUN wget --tries=3 --timeout=30 -O /tmp/web-build.zip \
    "${DOWNLOAD_BASE}/${GITHUB_REPO}/releases/latest/download/web-build.zip" && \
    unzip -o /tmp/web-build.zip -d /usr/share/nginx/html && \
    rm /tmp/web-build.zip

# nginx 配置统一使用 frontend/nginx.conf（唯一配置源），
# 构建上下文需为仓库根目录（docker-compose 中 context: ..）
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf
# docker-compose 网络内后端服务名为 api（backend/docker-compose*.yml）
RUN sed -i 's|http://mobile_portainer-api:8000|http://api:8000|g' /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
