# ================================================================
# Docker 构建忽略文件（供根目录 Dockerfile.cn All-in-One 构建使用）
#
# 排除不需要的目录/文件，减少构建上下文大小。
# CI 中实测上下文从 456MB 降至合理大小，避免 NAS 资源耗尽。
# ================================================================

# Git
.git
.gitattributes
.gitignore
.gitlab-ci.yml
.gitmodules

# 数据目录
data/

# 前端（保留 build/web 产物和 web.tar.gz 供 Dockerfile.cn COPY，排除其余构建中间产物）
# 注意：不能排除 frontend/build/web/ 与 web.tar.gz，否则 Dockerfile.cn 的
#   COPY 会构建失败（502 根因之一）
frontend/build/*
!frontend/build/web/
!frontend/build/web.tar.gz
frontend/.dart_tool/
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies
frontend/.packages
frontend/.pub-cache/
frontend/selenium_tests/reports/
# code01（shell executor）工作目录跨 job 持久化的 CI 缓存/虚拟环境，
# 与仓库无关，排除后可大幅减小构建上下文（实测 631MB → 数十 MB）：
frontend/.chrome/
frontend/.uv-cache/
frontend/selenium_tests/.venv/
frontend/selenium_tests/venv/
frontend/selenium_tests/.uv-cache/
frontend/selenium_tests_prod/.venv/
frontend/selenium_tests_prod/venv/

# 后端
backend/__pycache__/
backend/.venv/
backend/.pytest_cache/
backend/.uv-cache/
backend/data/
backend/static/avatars/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# IDE / OS
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Docker
docker-compose*.yml
Dockerfile*
.dockerignore

# CI / 文档
README.md
README_zh.md
LICENSE
AGENTS.md
CLAUDE.md
